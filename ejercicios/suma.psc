Algoritmo suma
	///Crear un algoritmo que pida al usuario dos números de tipo entero, realize la suma, e imprima
	///por pantalla el resultado.
	Definir numero1, numero2, resultado Como Entero
	Escribir "Por favor ingresa el primer número"
	Leer numero1
	Escribir "Por favor ingresa el segundo número"
	Leer numero2
	resultado = numero1+numero2
	Escribir "El resultado de la suma es: " resultado
FinAlgoritmo
